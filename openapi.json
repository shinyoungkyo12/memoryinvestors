                    { "type": "object", "properties": { "result": { "$ref": "#/components/schemas/PaginatedOrderResponse" } } }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Order"],
        "summary": "주문 생성",
        "operationId": "createOrder",
        "parameters": [{ "$ref": "#/components/parameters/AccountSeq" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OrderCreateRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
