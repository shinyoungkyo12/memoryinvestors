          }
        }
      }
    },
    "/api/v1/exchange-rate": {
      "get": {
        "tags": ["Market Info"],
        "summary": "환율 조회",
        "operationId": "getExchangeRate",
        "parameters": [
          { "name": "dateTime", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "name": "baseCurrency", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Currency" } },
          { "name": "quoteCurrency", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Currency" } }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "result": { "$ref": "#/components/schemas/ExchangeRateResponse" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market-calendar/KR": {
