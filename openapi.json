          "orderId": { "type": "string" },
          "symbol": { "type": "string" },
          "side": { "type": "string", "enum": ["BUY", "SELL"] },
          "orderType": { "type": "string", "enum": ["LIMIT", "MARKET"] },
          "timeInForce": { "type": "string", "enum": ["DAY", "CLS", "OPG"] },
          "status": { "$ref": "#/components/schemas/OrderStatus" },
          "price": { "type": ["string", "null"], "format": "decimal", "maxLength": 30 },
          "quantity": { "type": "string", "format": "decimal", "maxLength": 30 },
          "orderAmount": { "type": ["string", "null"], "format": "decimal", "maxLength": 30 },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "orderedAt": { "type": "string", "format": "date-time" },
          "canceledAt": { "type": ["string", "null"], "format": "date-time" },
          "execution": { "$ref": "#/components/schemas/OrderExecution" }
        }
      },
      "OrderExecution": {
        "type": "object",
        "required": ["filledQuantity", "averageFilledPrice", "filledAmount", "commission", "tax", "filledAt", "settlementDate"],
        "properties": {
          "filledQuantity": { "type": "string", "format": "decimal", "maxLength": 30 },
          "averageFilledPrice": { "type": ["string", "null"], "format": "decimal", "maxLength": 30 },
          "filledAmount": { "type": ["string", "null"], "format": "decimal", "maxLength": 30 },
          "commission": { "type": ["string", "null"], "format": "decimal", "maxLength": 30 },
          "tax": { "type": ["string", "null"], "format": "decimal", "maxLength": 30 },
          "filledAt": { "type": ["string", "null"], "format": "date-time" },
          "settlementDate": { "type": ["string", "null"], "format": "date" }
        }
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["PENDING", "PENDING_CANCEL", "PENDING_REPLACE", "PARTIAL_FILLED", "FILLED", "CANCELED", "REJECTED", "CANCEL_REJECTED", "REPLACE_REJECTED", "REPLACED"]
      },
      "BuyingPowerResponse": {
        "type": "object",
        "required": ["currency", "cashBuyingPower"],
        "properties": {
          "currency": { "$ref": "#/components/schemas/Currency" },
          "cashBuyingPower": { "type": "string", "format": "decimal", "maxLength": 30 }
        }
      },
      "SellableQuantityResponse": {
        "type": "object",
        "required": ["sellableQuantity"],
        "properties": {
          "sellableQuantity": { "type": "string", "format": "decimal", "maxLength": 30 }
        }
      },
      "Commission": {
        "type": "object",
        "required": ["marketCountry", "commissionRate"],
        "properties": {
          "marketCountry": { "$ref": "#/components/schemas/MarketCountry" },
          "commissionRate": { "type": "string", "format": "decimal", "maxLength": 30 },
          "startDate": { "type": ["string", "null"], "format": "date" },
          "endDate": { "type": ["string", "null"], "format": "date" }
        }
      }
    }
  }
}
