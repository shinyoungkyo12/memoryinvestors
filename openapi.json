          "preMarket": { "oneOf": [{ "$ref": "#/components/schemas/UsPreMarketSession" }, { "type": "null" }] },
          "regularMarket": { "oneOf": [{ "$ref": "#/components/schemas/UsRegularMarketSession" }, { "type": "null" }] },
