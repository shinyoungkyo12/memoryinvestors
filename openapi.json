  "components": {
    "securitySchemes": {
      "oauth2ClientCredentials": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "parameters": {
      "Symbol": {
        "name": "symbol",
        "in": "path",
        "required": true,
        "description": "종목 심볼. KRX: 6자리 숫자 (예: 005930), US: 영문 티커 (예: AAPL).",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9.\\-]+$" }
      },
      "SymbolQuery": {
        "name": "symbol",
        "in": "query",
        "required": true,
        "description": "종목 심볼. KRX: 6자리 숫자 (예: 005930), US: 영문 티커 (예: AAPL).",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9.\\-]+$" }
      },
      "AccountSeq": {
        "name": "X-Tossinvest-Account",
        "in": "header",
        "required": true,
        "description": "계좌 식별 키. `GET /api/v1/accounts` 응답의 `accountSeq` 값.",
        "schema": { "type": "integer", "format": "int64" }
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "description": "주문 식별자.",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["result"],
