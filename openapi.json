        "tags": ["Market Info"],
        "summary": "국내 장 운영 정보 조회",
        "operationId": "getKrMarketCalendar",
        "parameters": [
          { "name": "date", "in": "query", "required": false, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "result": { "$ref": "#/components/schemas/KrMarketCalendarResponse" } } }
