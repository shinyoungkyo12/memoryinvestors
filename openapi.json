      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/ApiError" } }
      },
      "ApiError": {
        "type": "object",
        "required": ["requestId", "code", "message"],
        "properties": {
          "requestId": { "type": "string" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "data": { "type": ["object", "null"], "additionalProperties": true }
        }
      },
      "Currency": {
        "type": "string",
        "enum": ["KRW", "USD"]
      },
      "MarketCountry": {
        "type": "string",
        "enum": ["KR", "US"]
      },
      "OAuth2TokenRequest": {
        "type": "object",
        "required": ["grant_type", "client_id", "client_secret"],
