      }
    },
    "/api/v1/holdings": {
      "get": {
        "tags": ["Asset"],
        "summary": "보유 주식 조회",
        "operationId": "getHoldings",
        "parameters": [
          { "$ref": "#/components/parameters/AccountSeq" },
          { "name": "symbol", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^[A-Za-z0-9.\\-]+$" } }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
