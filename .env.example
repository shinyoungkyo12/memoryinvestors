# ── MemoryInvestors 환경변수 ──────────────────────────────
# 1) Finnhub 무료 키 발급: https://finnhub.io/register
#    브라우저 WebSocket에서 사용되므로 클라이언트에 노출됩니다.
#    반드시 "무료 전용" 키를 사용하세요.
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_key_here

# 2) Twelve Data 무료 키 발급: https://twelvedata.com/pricing (Basic, $0)
#    서버 API route에서만 사용 — 클라이언트에 노출되지 않습니다.
TWELVE_DATA_API_KEY=your_twelvedata_key_here

# 3) (선택) 한국투자증권 KIS Developers 앱키 — 한국 종목 실시간 시세
#    https://apiportal.koreainvestment.com → 회원가입 → API 신청
#    미설정 시 Yahoo Finance 지연 시세(15~20분)로 자동 폴백됩니다.
KIS_APP_KEY=
KIS_APP_SECRET=

# 4) Supabase (DRAM 현물가 저장소) — https://supabase.com 무료 프로젝트 생성
#    Project Settings → API 에서 확인. service_role 키는 절대 클라이언트 노출 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 5) (선택) DART Open API — 삼성전자/SK하이닉스 재고 수집
#    https://opendart.fss.or.kr → 인증키 신청 (무료, 즉시 발급)
DART_API_KEY=

# (선택) 코스피200 야간선물 종목코드 — 미설정 시 기본 추정코드 사용
# KIS 종목마스터에서 야간선물(CME) 근월물 코드 확인 후 설정 (예: 101V06)
KIS_NIGHT_FUTURES_CODE=
