# ── MemoryInvestors 환경변수 ──────────────────────────────
# 1) Finnhub 무료 키 발급: https://finnhub.io/register
#    브라우저 WebSocket에서 사용되므로 클라이언트에 노출됩니다.
#    반드시 "무료 전용" 키를 사용하세요.
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_key_here

# 2) Twelve Data 무료 키 발급: https://twelvedata.com/pricing (Basic, $0)
#    서버 API route에서만 사용 — 클라이언트에 노출되지 않습니다.
TWELVE_DATA_API_KEY=your_twelvedata_key_here
